{
  "manifest_version": 3,
  "name": "Bridge Classroom Fetch",
  "version": "1.0.0",
  "description": "Send your bridge results from ACBL Live, ACBL Live for Clubs and Bridge Base Online to Bridge Classroom for analysis in one click.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Bridge Classroom Fetch",
    "default_icon": {
      "16": "icons/icon-16.png",
      "24": "icons/icon-24.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/sourceContent.js-loader-BGeHUJs_.js"
      ],
      "matches": [
        "https://live.acbl.org/*",
        "https://my.acbl.org/*",
        "https://webutil.bridgebase.com/v2/tview.php*",
        "https://www.bridgebase.com/myhands/hands.php*",
        "https://www.bridgebase.com/tools/handviewer.html*"
      ],
      "run_at": "document_idle"
    },
    {
      "js": [
        "assets/bboLobbyContent.js-loader-DehxJG53.js"
      ],
      "matches": [
        "https://www.bridgebase.com/v3/*"
      ],
      "run_at": "document_idle"
    },
    {
      "js": [
        "assets/ingestContent.js-loader-YThLzCxF.js"
      ],
      "matches": [
        "https://bridge-classroom.org/*",
        "https://bridge-classroom.com/*"
      ],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://live.acbl.org/*",
    "https://my.acbl.org/*",
    "https://webutil.bridgebase.com/*",
    "https://www.bridgebase.com/*",
    "https://tinyurl.bridgebase.com/*"
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "https://live.acbl.org/*",
        "https://my.acbl.org/*",
        "https://webutil.bridgebase.com/*",
        "https://www.bridgebase.com/*",
        "https://www.bridgebase.com/*"
      ],
      "resources": [
        "assets/preload-helper-ckwbz45p.js",
        "assets/index-CzyI_Ci2.js",
        "assets/browser-polyfill-C8sOovTA.js",
        "assets/sourceContent.js-jyziyDb6.js"
      ],
      "use_dynamic_url": false
    },
    {
      "matches": [
        "https://www.bridgebase.com/*"
      ],
      "resources": [
        "assets/preload-helper-ckwbz45p.js",
        "assets/browser-polyfill-C8sOovTA.js",
        "assets/bboLobbyContent.js-CKtIjG9p.js"
      ],
      "use_dynamic_url": false
    },
    {
      "matches": [
        "https://bridge-classroom.com/*",
        "https://bridge-classroom.org/*"
      ],
      "resources": [
        "assets/preload-helper-ckwbz45p.js",
        "assets/browser-polyfill-C8sOovTA.js",
        "assets/ingestContent.js-DKWPoPx4.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
