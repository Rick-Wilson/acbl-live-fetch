{
  "manifest_version": 3,
  "name": "ACBL Live Fetch",
  "version": "0.2.2",
  "description": "One-click extraction of bridge results from supported sites for analysis at bridge-classroom.org.",
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/sourceContent.js-loader-BK1fsHaU.js"
      ],
      "matches": [
        "https://live.acbl.org/*",
        "https://my.acbl.org/*",
        "https://webutil.bridgebase.com/v2/tview.php*",
        "https://www.bridgebase.com/myhands/hands.php*",
        "https://www.bridgebase.com/tools/handviewer.html*"
      ],
      "run_at": "document_idle"
    },
    {
      "js": [
        "assets/bboLobbyContent.js-loader-CmzkBL2w.js"
      ],
      "matches": [
        "https://www.bridgebase.com/v3/*"
      ],
      "run_at": "document_idle"
    },
    {
      "js": [
        "assets/ingestContent.js-loader-YThLzCxF.js"
      ],
      "matches": [
        "https://bridge-classroom.org/*",
        "https://bridge-classroom.com/*"
      ],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://live.acbl.org/*",
    "https://my.acbl.org/*",
    "https://webutil.bridgebase.com/*",
    "https://www.bridgebase.com/*"
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "https://live.acbl.org/*",
        "https://my.acbl.org/*",
        "https://webutil.bridgebase.com/*",
        "https://www.bridgebase.com/*",
        "https://www.bridgebase.com/*"
      ],
      "resources": [
        "assets/preload-helper-ckwbz45p.js",
        "assets/index-BpKWQ6iT.js",
        "assets/browser-polyfill-C8sOovTA.js",
        "assets/sourceContent.js-KrgStwI7.js"
      ],
      "use_dynamic_url": false
    },
    {
      "matches": [
        "https://www.bridgebase.com/*"
      ],
      "resources": [
        "assets/preload-helper-ckwbz45p.js",
        "assets/browser-polyfill-C8sOovTA.js",
        "assets/bboLobbyContent.js-DwFzYMdT.js"
      ],
      "use_dynamic_url": false
    },
    {
      "matches": [
        "https://bridge-classroom.com/*",
        "https://bridge-classroom.org/*"
      ],
      "resources": [
        "assets/preload-helper-ckwbz45p.js",
        "assets/browser-polyfill-C8sOovTA.js",
        "assets/ingestContent.js-DKWPoPx4.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
